+@Test @MainActor func rediscoveryKeepsMetaSignInAndWaitsBeforeClaim() async throws {
+    let defaults = MemoryDefaults()
+    let connection = RecordedConnection()
+    let store = SavedSessionStore()
+    store.saved = MetaSession(accessToken: "synthetic-saved", userID: "test")
+    let model = BandModel(defaults: defaults, connection: connection, controls: RecordingControls(), sessionStore: store, clock: { 100 })
+    model.selectedAddress = "old-band"
+    model.restartBandDiscovery()
+    #expect(model.selectedAddress.isEmpty)
+    #expect(model.pairRoute == .scanning && model.discoveryOnly)
+    #expect(connection.requests == ["scan"])
+    #expect(store.deletions == 0 && store.saved?.accessToken == "synthetic-saved")
+    connection.send(.devices([BandDevice(address: "new-band", name: "Meta Band New", rssi: -40)]))
+    connection.finish()
+    #expect(model.selectedAddress == "new-band")
+    #expect(model.pairRoute == .none && !model.busy)
+    #expect(connection.requests == ["scan"])
+    #expect(store.deletions == 0 && store.saved?.accessToken == "synthetic-saved")
+    await model.shutdown()
+}
